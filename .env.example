# Copy to .env at the project root, fill in real values locally.
# The CLI and pytest load this file automatically; do not source it in the shell.
# Keep .env out of git; this example file intentionally contains placeholders.

# Integration-test gate. Set to 1 only when you intend to run live provider smoke tests.
SEO_RANK_RUN_LIVE_INTEGRATION=0

# CLI live-provider gate. Set to 1 only when you intend to call paid/live APIs.
SEO_RANK_ENABLE_LIVE_PROVIDERS=0

# DataForSEO API credentials. DataForSEO uses API login/password Basic Auth.
DATAFORSEO_LOGIN=replace-with-dataforseo-api-login
DATAFORSEO_PASSWORD=replace-with-dataforseo-api-password

# TextRazor API credential. TextRazor sends this as the X-TextRazor-Key header.
TEXTRAZOR_API_KEY=replace-with-textrazor-api-key

# Vertex AI (Phase 4: Gemini Doc Retrieval + Gemini Semantic Similarity).
GOOGLE_CLOUD_PROJECT=replace-with-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
# Use ADC (gcloud auth application-default login) or:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# BGE runs locally via FlagEmbedding; no API key. GPU recommended.
# Optional: gate local model download / inference when Phase 4 live similarity ships.
# SEO_RANK_ENABLE_BGE=0
